# Public base URL of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiry form email (server-side only — never prefix these with NEXT_PUBLIC_).
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
CONTACT_FROM_EMAIL="GOR Website <website@alshabaka-althahabiya.com.iq>"
# Where enquiries are delivered (defaults to info@alshabaka-althahabiya.com.iq).
CONTACT_TO_EMAIL=info@alshabaka-althahabiya.com.iq
# Optional: signs anti-spam form tokens (defaults to a value derived from RESEND_API_KEY).
CONTACT_FORM_SECRET=
